BWC_RESEARCH_PROVIDER=live
BWC_APP_TITLE=BWC Sales Intelligence
BWC_REQUEST_TIMEOUT=12
BWC_FREE_PROVIDER_TIMEOUT=3
BWC_PROVIDER_RETRY_ATTEMPTS=1
BWC_RESEARCH_CONCURRENCY=8
BWC_RESEARCH_CACHE_TTL=900
BWC_RESEARCH_DEPTH=normal
# Optional public search fallback
BRAVE_SEARCH_API_KEY=
SEARXNG_ENABLED=false
SEARXNG_URL=http://localhost:8080
JINA_ENABLED=true
JINA_READER_URL=https://r.jina.ai
JINA_API_KEY=
DIRECT_READER_ENABLED=true
MAX_RESEARCH_ROUNDS=3
MAX_SEARCH_QUERIES_PER_ROUND=10
MAX_RESULTS_PER_QUERY=10
MAX_PAGES_TO_READ=15
MAX_FOLLOWUP_QUERIES=10
RESEARCH_DEBUG=false
# Optional: enables Gemini + Google Search grounding. Leave blank for free no-key search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
BWC_CRM_PATH=crm_data.json